# Supabase PostgreSQL connection string
# Find this in Supabase: Project Settings > Database > Connection string > URI
# Tip: Use the connection pooling URI (port 6543) or direct URI (port 5432)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# JWT Secret for signing verification certificates & sessions
JWT_SECRET="sih26036-legal-metrology-hmac-secret-key-2026"

# On-site enforcement (public: the browser needs them too — not secrets)
# How close the officer's GPS fix must be to the registered premises, in metres
NEXT_PUBLIC_GEOFENCE_RADIUS_M=200
# Worst GPS accuracy accepted, in metres
NEXT_PUBLIC_MAX_GPS_ACCURACY_M=100
# true = allow a hand-picked location, for laptop demos without GPS. Keep false in real use.
NEXT_PUBLIC_DEMO_LOCATION=false
